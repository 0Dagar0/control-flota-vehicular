# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube a Git.

DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-generada
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: sqlite3 (desarrollo) o postgresql (producción)
DB_ENGINE=sqlite3

# Solo si DB_ENGINE=postgresql
DB_NAME=mi_flota
DB_USER=mi_flota
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Correo saliente (SMTP) ---
# Sin EMAIL_HOST los correos se imprimen en la consola del servidor.
# Con Gmail: smtp.gmail.com, puerto 587 y la contraseña de aplicación de 16
# caracteres (no la contraseña normal de la cuenta). Ver docs/GUIA_ENTORNO.md.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=miflota.granjero@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion-de-16-caracteres
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Mi Flota <miflota.granjero@gmail.com>

# --- Telegram (avisos) ---
# Token del bot creado con @BotFather. Sin token, el canal Telegram queda apagado.
TELEGRAM_BOT_TOKEN=123456789:AAejemplo-no-real
TELEGRAM_TIMEOUT=10

# --- Web Push (VAPID) ---
# La publica va en base64url; la privada es el PEM en base64. No las regeneres sin
# avisar: las suscripciones existentes dejarian de funcionar.
VAPID_PUBLIC_KEY=<clave-publica-base64url>
VAPID_PRIVATE_KEY_B64=<clave-privada-pem-en-base64>
VAPID_ADMIN_EMAIL=avisos@ejemplo.com
WEB_PUSH_TIMEOUT=10

# --- Cola de notificaciones (opcional) ---
# 3 intentos por canal, espera base de 60 s (60/120/240) y escalamiento a los 5 min.
NOTIFICACIONES_INTENTOS=3
NOTIFICACIONES_ESPERA=60
NOTIFICACIONES_ESCALAMIENTO_MINUTOS=5

# --- Produccion con HTTPS (opcion A: PC + Cloudflare Tunnel) ---
# Descomentar y completar solo cuando el dominio ya este activo. En desarrollo local
# se dejan fuera o en False, si no el navegador no podria entrar por http://127.0.0.1.
# CSRF_TRUSTED_ORIGINS=https://miflota.tudominio.com
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# ALLOWED_HOSTS=localhost,127.0.0.1,miflota.tudominio.com
