# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube a Git.

DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-generada
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: sqlite3 (desarrollo) o postgresql (producción)
DB_ENGINE=sqlite3

# Solo si DB_ENGINE=postgresql
DB_NAME=mi_flota
DB_USER=mi_flota
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Correo saliente (SMTP) ---
# Sin EMAIL_HOST los correos se imprimen en la consola del servidor.
# Con Gmail: smtp.gmail.com, puerto 587 y la contraseña de aplicación de 16
# caracteres (no la contraseña normal de la cuenta). Ver docs/GUIA_ENTORNO.md.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=miflota.granjero@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion-de-16-caracteres
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Mi Flota <miflota.granjero@gmail.com>
