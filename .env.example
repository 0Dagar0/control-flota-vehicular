# Copia este archivo como .env y completa los valores.
# El archivo .env NO se sube a Git.

DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-generada
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: sqlite3 (desarrollo) o postgresql (producción)
DB_ENGINE=sqlite3

# Solo si DB_ENGINE=postgresql
DB_NAME=mi_flota
DB_USER=mi_flota
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
